{
  "name": "vibeCDA · game studio",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "remoteUser": "node",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "Your game", "onAutoForward": "openBrowser", "visibility": "private" }
  },
  "onCreateCommand": "node scripts/bootstrap.mjs",
  "postAttachCommand": "cat docs/welcome.txt",
  "customizations": {
    "vscode": {
      "extensions": [],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.autoSave": "afterDelay"
      }
    }
  }
}
