{
  "name": "vibeCDA \u00b7 local build (including Apple Silicon)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../.."
  },
  "remoteUser": "node",
  "forwardPorts": [
    5173
  ],
  "portsAttributes": {
    "5173": {
      "label": "Your game",
      "onAutoForward": "openBrowser"
    }
  },
  "onCreateCommand": "bash .devcontainer/configure-shell.sh && node scripts/bootstrap.mjs",
  "postAttachCommand": "cat docs/welcome.txt",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1.1.0": {}
  }
}
